shenv LANG 'en_US.UTF-8'
shenv EDITOR 'micro'
shenv VISUAL 'micro'
shenv MICRO_TRUECOLOR '1'
shenv BROWSER '/usr/bin/google-chrome-stable'
shenv TERMINAL '/usr/bin/kitty'
shenv TERMINAL_CMD 'kitty -e'
shenv TERM 'xterm-kitty'

shenv _JAVA_AWT_WM_NONREPARENTING '1' 
shenv _JAVA_OPTIONS '-Dsun.java2d.opengl=true'

shenv XDG_DATA_HOME "$HOME/.local/share"
shenv XDG_CONFIG_HOME "$HOME/.config"
shenv XDG_STATE_HOME "$HOME/.local/state"
shenv XDG_CACHE_HOME "$HOME/.cache"
shenv XDG_BIN_HOME "$HOME/.local/bin"

shenv ZDOTDIR "$XDG_CONFIG_HOME/zsh"
shenv GTK2_RC_FILES "$XDG_CONFIG_HOME/gtk-2.0/gtkrc"
shenv XCURSOR_PATH "/usr/share/icons:$XDG_DATA_HOME/icons"
shenv CARGO_HOME "$XDG_DATA_HOME/cargo"
shenv CUDA_CACHE_PATH "$XDG_CACHE_HOME/nv"
shenv GNUPGHOME "$XDG_DATA_HOME/gnupg"
shenv REDISCLI_HISTFILE "$XDG_DATA_HOME/redis/rediscli_history"
shenv RUSTUP_HOME "$XDG_DATA_HOME/rustup"
shenv NODE_REPL_HISTORY "$XDG_DATA_HOME/node_repl_history"
shenv PYENV_ROOT "$XDG_DATA_HOME/pyenv"
shenv WAKATIME_HOME "$XDG_CONFIG_HOME/wakatime"

shenv QT_QPA_PLATFORM 'wayland;xcb'
shenv QT_QPA_PLATFORMTHEME 'qt6ct'
shenv QT_AUTO_SCREEN_SCALE_FACTOR '1'
shenv QT_WAYLAND_DISABLE_WINDOWDECORATION '1'
shenv GDK_SCALE '1'
shenv ELECTRON_OZONE_PLATFORM_HINT 'auto'

# Gist
shenv GITHUB_TOKEN ''
shenv GITHUB_USER 'phamhuulocforwork'
shenv OBSIDIAN_GIST_DIR '/home/billarch/Documents/Obsidian'

# Fcitx5 Input Method
shenv GTK_IM_MODULE "fcitx"
shenv QT_IM_MODULE "fcitx"
shenv XMODIFIERS "@im=fcitx"
shenv SDL_IM_MODULE "fcitx"
shenv GLFW_IM_MODULE "ibus"

# Wayland specific
shenv QT_QPA_PLATFORM "wayland"
shenv GDK_BACKEND "wayland"
